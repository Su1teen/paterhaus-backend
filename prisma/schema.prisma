generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MARKETING
  OWNER_ACQUISITION
  OPERATIONS
}

enum CampaignPlatform {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WHATSAPP
  REFERRAL
  OTHER
}

enum CampaignDirection {
  PROPERTY_MANAGEMENT
  SNAGGING
  STAGING
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum LeadDirection {
  UNCLASSIFIED
  PROPERTY_MANAGEMENT
  SNAGGING
  STAGING
}

enum LeadSource {
  META_CONNECTOR
  META_LEAD_ADS
  WHATSAPP
  WEBSITE
  REFERRAL
  MANUAL
  OTHER
}

enum MappingStatus {
  MAPPED
  NEEDS_REVIEW
  FAILED
}

enum LeadEventType {
  LEAD_CREATED
  WEBHOOK_RECEIVED
  STAGE_CHANGED
  ASSIGNED
  NOTE_ADDED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  MAPPING_REVIEW_REQUIRED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  NEEDS_REVIEW
  FAILED
}

enum ProjectStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPaymentType {
  PREPAYMENT
  PARTIAL
  FINAL
  REFUND
  OTHER
}

enum ProjectPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model Campaign {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  platform  CampaignPlatform
  direction CampaignDirection
  status    CampaignStatus
  spendUsd  Decimal           @default(0) @db.Decimal(12, 2)
  spendAmount Decimal?         @db.Decimal(12, 2)
  currency  String?
  archivedAt DateTime?
  startsAt  DateTime?
  endsAt    DateTime?
  notes     String?
  objective        String?   // AWARENESS | REACH | TRAFFIC | LEAD_GENERATION | CONVERSIONS
  targetAudienceJson String? // JSON строка с настройками аудитории
  adCreativeUrl    String?
  impressions      Int?
  clicks           Int?
  reach            Int?
  conversions      Int?
  dailyBudget      Decimal?  @db.Decimal(12, 2)
  lifetimeBudget   Decimal?  @db.Decimal(12, 2)
  bidStrategy      String?   // LOWEST_COST | COST_CAP | BID_CAP
  externalCampaignId String? // Meta/Facebook Campaign ID
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  leads Lead[]
  marketingLeads MarketingLeadEntry[]

  @@index([direction])
  @@index([status])
  @@index([platform])
}

model Lead {
  id String @id @default(uuid()) @db.Uuid

  externalLeadId  String?
  externalChatId  String? @unique
  archivedAt      DateTime?
  priority        String?
  nextActionType  String?
  nextActionText  String?
  nextActionAt    DateTime?
  note            String?
  quotedAmount    Decimal? @db.Decimal(14, 2)
  agreedAmount    Decimal? @db.Decimal(14, 2)
  currency        String   @default("AED")
  name            String?
  phone           String?
  normalizedPhone String?
  email           String?
  normalizedEmail String?

  propertyType String?
  propertyArea String?
  bedrooms     Int?
  serviceRaw   String?

  direction LeadDirection @default(UNCLASSIFIED)
  stage     String        @default("new")
  source    LeadSource

  mappingStatus MappingStatus @default(MAPPED)

  campaignId String? @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  assignedUserId String? @db.Uuid
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  firstResponseAt    DateTime?
  firstResponseDueAt DateTime?
  followUpDueAt      DateTime?

  lostReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attribution   LeadAttribution?
  events        LeadEvent[]
  webhookEvents WebhookEvent[]
  properties Property[]
  projects ServiceProject[] @relation("ProjectOwnerLead")
  sourceProjects ServiceProject[] @relation("ProjectSourceOpportunity")

  @@unique([source, externalLeadId], name: "source_externalLeadId")
  @@index([externalLeadId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([createdAt])
  @@index([direction])
  @@index([stage])
  @@index([source])
  @@index([campaignId])
  @@index([mappingStatus])
  @@index([archivedAt])
}

model LeadAttribution {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @unique @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  platform           String?
  campaignExternalId String?
  campaignName       String?
  adSetExternalId    String?
  adSetName          String?
  adExternalId       String?
  adName             String?
  formExternalId     String?
  formName           String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  firstTouchAt DateTime?
  capturedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingLeadEntry {
  id             String    @id @default(uuid()) @db.Uuid
  entryDate      DateTime
  name           String
  phone          String?
  email          String?
  propertyType   String?   // apartment, villa, townhouse etc
  service        String?   // snagging, home_staging, property_management
  firstFollowUp  String?   // текст статуса первого follow-up
  secondFollowUp String?   // текст статуса второго follow-up
  comments       String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([entryDate])
  @@index([service])
  @@index([archivedAt])
  @@index([campaignId])
}

model LeadEvent {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        LeadEventType
  description String
  metadata    Json?
  occurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([leadId])
  @@index([type])
  @@index([occurredAt])
}

model WebhookEvent {
  id             String  @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String?
  externalLeadId String?

  payload Json
  headers Json?

  status       WebhookEventStatus @default(RECEIVED)
  errorMessage String?

  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider])
  @@index([status])
  @@index([receivedAt])
  @@index([externalLeadId])
}

model IntegrationMapping {
  id       String @id @default(uuid()) @db.Uuid
  provider String

  sourceField String
  sourceValue String

  targetField String
  targetValue String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, sourceField, sourceValue, targetField])
  @@index([provider])
  @@index([active])
}

model CalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  /** Calendar day in Asia/Dubai, stored as YYYY-MM-DD. */
  eventDate   String
  /** Optional local start time in Asia/Dubai, stored as HH:MM. */
  startTime   String?
  endTime     String?
  kind        String   @default("operation")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDate])
  @@index([createdBy])
}

model Property {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String?
  area         String?
  type         String?
  unit         String?
  bedrooms     Int?
  bathrooms    Int?
  ownerLeadId  String?  @db.Uuid
  ownerLead    Lead?    @relation(fields: [ownerLeadId], references: [id], onDelete: SetNull)
  status       String   @default("ACTIVE")
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projects     ServiceProject[]
  stays        Stay[]
  documents    InternalDocument[]

  @@index([ownerLeadId])
  @@index([archivedAt])
}

model ServiceProject {
  id                     String        @id @default(uuid()) @db.Uuid
  propertyId             String?       @db.Uuid
  property               Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownerLeadId            String?       @db.Uuid
  ownerLead              Lead?         @relation("ProjectOwnerLead", fields: [ownerLeadId], references: [id], onDelete: SetNull)
  sourceOpportunityId    String?       @db.Uuid
  sourceOpportunity      Lead?         @relation("ProjectSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  name                   String
  serviceDirections      String[]      @default([])
  status                 ProjectStatus @default(DRAFT)
  quotedAmount           Decimal?      @db.Decimal(14, 2)
  agreedAmount           Decimal?      @db.Decimal(14, 2)
  currency               String        @default("AED")
  startDate              DateTime?
  expectedCompletionDate DateTime?
  completedAt            DateTime?
  confirmedAt            DateTime?
  comment                String?
  archivedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  milestones             ProjectMilestone[]
  payments               ProjectPayment[]
  contractors            ProjectContractorAssignment[]
  documents              InternalDocument[]

  @@index([propertyId])
  @@index([ownerLeadId])
  @@index([sourceOpportunityId])
  @@index([status, archivedAt])
}

model ProjectMilestone {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  project     ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  sortOrder   Int
  completedAt DateTime?
  comment     String?
  responsible String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, sortOrder])
}

model ProjectPayment {
  id        String               @id @default(uuid()) @db.Uuid
  projectId String               @db.Uuid
  project   ServiceProject       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  amount    Decimal              @db.Decimal(14, 2)
  currency  String               @default("AED")
  type      ProjectPaymentType
  status    ProjectPaymentStatus @default(PENDING)
  paidAt    DateTime?
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([projectId, status])
  @@index([paidAt])
}

model Contractor {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactPerson String?
  phone        String?
  email        String?
  notes        String?
  active       Boolean  @default(true)
  serviceTypes String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignments  ProjectContractorAssignment[]
  documents    InternalDocument[]
}

model ProjectContractorAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  project      ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId String         @db.Uuid
  contractor   Contractor     @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  scope        String?
  amount       Decimal?       @db.Decimal(14, 2)
  currency     String         @default("AED")
  status       String?
  assignedAt   DateTime       @default(now())
  completedAt  DateTime?
  note         String?

  @@unique([projectId, contractorId])
  @@index([contractorId])
}

model Guest {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  email       String?
  nationality String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stays       Stay[]
}

model Stay {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guestId       String   @db.Uuid
  guest         Guest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  source        String?
  checkIn       DateTime
  checkOut      DateTime
  guestCount    Int      @default(1)
  bookingValue  Decimal? @db.Decimal(14, 2)
  currency      String   @default("AED")
  paymentStatus String   @default("UNPAID")
  status        String   @default("BOOKED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, checkIn])
  @@index([guestId])
  @@index([status, checkIn])
}

model InternalDocument {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  storageKey       String          @unique
  category         String
  description      String?
  uploadedBy       String
  propertyId       String?         @db.Uuid
  property         Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  projectId        String?         @db.Uuid
  project          ServiceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractorId     String?         @db.Uuid
  contractor       Contractor?     @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([category, createdAt])
}
